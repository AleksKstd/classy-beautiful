# Copy to .env.local for local development, and set the same variables
# in your hosting provider (e.g. Vercel > Project > Settings > Environment Variables).

# --- Supabase (Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Public "anon" key - safe to expose; Row Level Security limits it to public data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# SECRET "service_role" key - server only, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://your-domain.bg

# --- Admin login ---
ADMIN_USERNAME=choose_a_username
# Generate with: npm run hash-password -- "your new password"
ADMIN_PASSWORD_HASH=scrypt$...
# Random string, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs out every admin session.
ADMIN_SESSION_SECRET=

# --- Private Google Calendar feed ---
# Random string, at least 32 characters (same command as above).
# Changing it invalidates the old calendar subscription link.
CALENDAR_FEED_TOKEN=

# --- Email (optional, https://resend.com) ---
RESEND_API_KEY=
EMAIL_FROM=Classy & Beautiful <noreply@your-domain.bg>
